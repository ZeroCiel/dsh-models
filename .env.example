# DeepSeek Harness 模型线路配置 —— 复制到 %USERPROFILE%\.dsh\.env 后填入真实密钥。
# 本文件只是变量名模板，不含任何真实密钥；真实 .env 永远不要提交或推送。
# 本地网关类线路（magpie / gitcode）不需要真实密钥，占位 none 即可。

DEEPSEEK_API_KEY=sk-在这里填DeepSeek官方开放平台密钥
AMD_API_KEY=rc-在这里填AMD Radeon云密钥
BAIZHI_API_KEY=sk-在这里填百智云密钥
XAI_API_KEY=xai-在这里填xAI密钥
MAGPIE_GATEWAY_KEY=none
ZHIPU_API_KEY=在这里填智谱开放平台密钥
SCNET_API_KEY=sk-tp-N在这里填SCNet密钥
MOMA_API_KEY=在这里填移动云MoMA密钥
DEEPSEEK_OFFICIAL_KEY=sk-在这里填DeepSeek官方密钥
MODELSCOPE_API_KEY=ms-在这里填魔搭ModelScope密钥
TOKENROUTER_API_KEY=sk-在这里填TokenRouter密钥
GITCODE_API_KEY=none
APINEX_API_KEY=在这里填APInex密钥
